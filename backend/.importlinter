[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:domain-independence]
name = Domain does not import application layers
type = forbidden
source_modules =
    app.modules.*.domain
forbidden_modules =
    app.modules.*.api
    app.modules.*.service
    app.modules.*.repositories
    app.modules.*.adapters
    app.modules.*.tasks
    app.infra
    app.entrypoints
    app.composition
allow_indirect_imports = True

[importlinter:contract:infra-boundary]
name = Infrastructure does not import API, services, or composition
type = forbidden
source_modules =
    app.infra
    app.modules.*.repositories
    app.modules.*.adapters
forbidden_modules =
    app.modules.*.api
    app.modules.*.service
    app.modules.*.tasks
    app.entrypoints
    app.composition
allow_indirect_imports = True

[importlinter:contract:service-boundary]
name = Services do not import API or composition
type = forbidden
source_modules =
    app.modules.*.service
forbidden_modules =
    app.modules.*.api
    app.modules.*.tasks
    app.entrypoints
    app.composition
allow_indirect_imports = True

[importlinter:contract:api-boundary]
name = API contains transport concerns only
type = forbidden
source_modules =
    app.modules.*.api
forbidden_modules =
    app.modules.*.repositories
    app.modules.*.adapters
    app.modules.*.tasks
    app.infra
    sqlalchemy
allow_indirect_imports = True

# A task pulls in its service, its adapters and its provider. Importing one from
# a router loads all of that into the HTTP process at boot, so an import error
# inside a worker task takes the API down on a route nobody called. Dispatch by
# name through app.entrypoints.worker.task_runner instead.
[importlinter:contract:task-boundary]
name = Tasks are thin entrypoints
type = forbidden
source_modules =
    app.modules.*.tasks
forbidden_modules =
    app.modules.*.repositories
    app.modules.*.adapters
    app.infra
    sqlalchemy
allow_indirect_imports = True

[importlinter:contract:market-data-module-boundary]
name = Market data does not depend on the portfolio or AI modules
type = forbidden
source_modules =
    app.modules.market_data.api
    app.modules.market_data.domain
    app.modules.market_data.service
    app.modules.market_data.repositories
    app.modules.market_data.tasks
forbidden_modules =
    app.modules.ai
    app.modules.portfolio
    app.modules.users.repositories
    app.modules.*.infra
allow_indirect_imports = True

[importlinter:contract:portfolio-module-boundary]
name = Portfolio does not import repositories from other modules
type = forbidden
source_modules =
    app.modules.portfolio.api
    app.modules.portfolio.domain
    app.modules.portfolio.service
forbidden_modules =
    app.modules.ai.repositories
    app.modules.market_data.repositories
    app.modules.users.repositories
    app.modules.*.infra
allow_indirect_imports = True

[importlinter:contract:ai-module-boundary]
name = AI does not import repositories from other modules
type = forbidden
source_modules =
    app.modules.ai.api
    app.modules.ai.domain
    app.modules.ai.service
forbidden_modules =
    app.modules.market_data.repositories
    app.modules.portfolio.repositories
    app.modules.users.repositories
    app.modules.*.infra
allow_indirect_imports = True

[importlinter:contract:research-module-boundary]
name = Research does not import repositories from other modules
type = forbidden
source_modules =
    app.modules.research.api
    app.modules.research.domain
    app.modules.research.service
forbidden_modules =
    app.modules.ai.repositories
    app.modules.market_data.repositories
    app.modules.portfolio.repositories
    app.modules.users.repositories
    app.modules.*.infra
allow_indirect_imports = True

[importlinter:contract:lab-module-boundary]
name = Lab does not import repositories from other modules
type = forbidden
source_modules =
    app.modules.lab.api
    app.modules.lab.domain
    app.modules.lab.service
forbidden_modules =
    app.modules.ai.repositories
    app.modules.market_data.repositories
    app.modules.portfolio.repositories
    app.modules.research.repositories
    app.modules.users.repositories
    app.modules.*.infra
