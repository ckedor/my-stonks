{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // `src/components/ui/index.ts` entra como entry point de propósito: o design
  // system é superfície pública, e durante a migração ele exporta coisas que
  // nenhuma página consome ainda. Sem isso, o knip lista uma dúzia de falsos
  // positivos e vira ruído que se aprende a ignorar.
  //
  // O preço é real: componente do design system que morrer não é detectado
  // aqui. Vale revisitar quando o baseline chegar a zero e as exportações
  // tiverem consumidor de verdade.
  "entry": [
    "src/main.tsx",
    "src/components/ui/index.ts",
    "e2e/**/*.spec.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}"],

  // Mesmo critério do pre-commit, aplicado por categoria: o que está verde
  // bloqueia, o que ainda não está reporta.
  //
  // `files` e `dependencies` estão zerados e passam a bloquear — é a
  // categoria que importa contra o viés aditivo de um agente, que adiciona
  // arquivo e quase nunca remove.
  //
  // `exports` e `types` ainda acusam ~30 símbolos. Tirar o `export` de um
  // símbolo é seguro, mas apagá-lo exige julgamento caso a caso; ficam
  // reportando até alguém passar por eles.
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "enumMembers": "warn",
    "nsExports": "warn",
    "nsTypes": "warn"
  }
}
