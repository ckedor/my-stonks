{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PostgreSQL (Docker)",
      "type": "shell",
      "command": "docker compose up -d --wait db",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Start Redis (Docker)",
      "type": "shell",
      "command": "docker compose up -d redis",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Database Migrations",
      "type": "shell",
      "command": "./.venv/bin/alembic upgrade head",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Dependencies",
      "dependsOn": [
        "Start PostgreSQL (Docker)",
        "Start Redis (Docker)",
        "Run Database Migrations"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Frontend Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
